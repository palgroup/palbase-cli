--- /dev/null
+++ b/codegen-gradle/src/main/kotlin/io/palbase/gradle/LibraryFallbackCheck.kt
@@ -0,0 +1,137 @@
+package io.palbase.gradle
+
+import com.android.build.api.dsl.ApplicationExtension
+import org.gradle.api.Project
+import org.gradle.api.artifacts.ProjectDependency
+
+/**
+ * A LIBRARY CANNOT SEE THE BUILD TYPE IT IS PACKED INTO.
+ *
+ * The plugin resolves one environment per variant of the module it is applied
+ * to. A library has variants only for the build types IT declares. When an app
+ * build type the library lacks — `featureX` — pulls the library in, AGP picks
+ * the library's `matchingFallbacks` variant (`debug`) instead, and that
+ * variant's client and `palbase-config.json` ride into the `featureX` APK. The
+ * build-type-name rule never runs for `featureX`, because no `featureX` variant
+ * of the library exists; nothing in the library's own build can tell.
+ *
+ * So the library LOOKS: once every project is configured, it reads the build
+ * types of the application modules that depend on it, and for each one it lacks
+ * compares what that build type WOULD select (the same resolver, same places)
+ * with what the fallback variant compiled. A difference is a warning, not a
+ * failure: the library task that compiled `debug` serves the app's `debug` too,
+ * and failing it would take down a build that is correct. The warning names
+ * both ways out — declare the build type in the library, or say the fallback's
+ * environment is intended (`palbase.env.<build type>=<that environment>`), which
+ * makes the two answers agree and silences it.
+ *
+ * Reading another project's model is not allowed under Isolated Projects; the
+ * check is skipped there (see [PalbaseCodegenPlugin]).
+ */
+internal object LibraryFallbackCheck {
+
+    /** One app build type, as the app's finished DSL declares it. */
+    data class AppBuildType(val name: String, val matchingFallbacks: List<String>)
+
+    /** A library variant and what it compiled. */
+    data class LibraryVariant(val name: String, val resolution: EnvironmentResolution)
+
+    /** One app build type that packs a library variant compiled for a different environment. */
+    data class Finding(
+        val appPath: String,
+        val appBuildType: String,
+        /** The library variants it packs instead of its own, each with a different environment than it would select. */
+        val packedVariants: List<String>,
+        val message: String,
+    )
+
+    fun register(
+        library: Project,
+        resolver: EnvironmentResolver,
+        libraryBuildTypes: Set<String>,
+        libraryVariants: Map<String, List<LibraryVariant>>,
+    ) {
+        library.gradle.projectsEvaluated { gradle ->
+            for (app in applicationsDependingOn(gradle.rootProject, library.path)) {
+                // A different AGP class loader in the app than in this module would
+                // make the cast fail; the check then has nothing it can read.
+                val android = app.extensions.findByName("android") as? ApplicationExtension ?: continue
+                val appBuildTypes = android.buildTypes.map { AppBuildType(it.name, it.matchingFallbacks.toList()) }
+                findings(app.path, library.path, appBuildTypes, libraryBuildTypes, libraryVariants, resolver)
+                    .forEach { finding ->
+                        library.logger.warn(finding.message)
+                        // And on the fallback's OWN line, printed whenever it generates —
+                        // the configuration-time warning is not repeated when a
+                        // configuration cache entry is reused.
+                        finding.packedVariants.forEach { variant ->
+                            library.tasks.named(taskName(variant), GeneratePalbaseTask::class.java).configure {
+                                it.alsoPackedInto.add("`${finding.appPath}` ${finding.appBuildType}")
+                            }
+                        }
+                    }
+            }
+        }
+    }
+
+    fun taskName(variant: String) = "generatePalbase" + variant.replaceFirstChar { it.uppercase() }
+
+    /** Pure, so the rule is testable without a build: one sentence per app build type that gets the wrong stack. */
+    fun findings(
+        appPath: String,
+        libraryPath: String,
+        appBuildTypes: List<AppBuildType>,
+        libraryBuildTypes: Set<String>,
+        libraryVariants: Map<String, List<LibraryVariant>>,
+        resolver: EnvironmentResolver,
+    ): List<Finding> = appBuildTypes.mapNotNull { buildType ->
+        if (buildType.name in libraryBuildTypes) return@mapNotNull null
+        // No fallback the library has: AGP fails the dependency resolution itself, loudly.
+        val fallback = buildType.matchingFallbacks.firstOrNull { it in libraryBuildTypes } ?: return@mapNotNull null
+        val wanted = resolver.resolve(buildType.name, buildType.name)
+        val packed = libraryVariants[fallback].orEmpty().mapNotNull { variant ->
+            // A fallback that is itself refused fails its own task when it runs.
+            (variant.resolution as? EnvironmentResolution.Selected)?.let { variant.name to it }
+        }
+        val wrong = packed.filter { (_, got) ->
+            wanted !is EnvironmentResolution.Selected || wanted.environment != got.environment
+        }
+        if (wrong.isEmpty()) return@mapNotNull null
+
+        val got = wrong.joinToString(", ") { (variant, selected) ->
+            "`${selected.environment}` for `$variant` (${selected.origin})"
+        }
+        val would = when (wanted) {
+            is EnvironmentResolution.Selected -> "would select `${wanted.environment}` (${wanted.origin})"
+            is EnvironmentResolution.Refused -> "would be refused: ${wanted.reason}"
+        }
+        val intended = wrong.map { it.second.environment }.distinct().singleOrNull()
+        val message = "Palbase: `$appPath` build type `${buildType.name}` is not declared in `$libraryPath`, so AGP packs " +
+            "`$libraryPath`'s `$fallback` build into it (matchingFallbacks) — and with it the Palbase client and " +
+            "config `$libraryPath` generated for that build: $got. `${buildType.name}` itself $would, but a " +
+            "library compiles only the build types it declares. Declare it in `$libraryPath` too " +
+            "(`buildTypes { create(\"${buildType.name}\") { initWith(getByName(\"$fallback\")) } }`)" +
+            (
+                intended?.let {
+                    ", or, if `$it` is what `${buildType.name}` should use, say so: " +
+                        "`${EnvironmentResolver.PROPERTY_PREFIX}${buildType.name}=$it` in gradle.properties."
+                } ?: "."
+                )
+        Finding(appPath, buildType.name, wrong.map { it.first }, message)
+    }
+
+    /** Application modules whose declared project dependencies reach [libraryPath], directly or through other modules. */
+    private fun applicationsDependingOn(root: Project, libraryPath: String): List<Project> {
+        val projects = root.allprojects
+        val edges = projects.associate { project ->
+            project.path to project.configurations
+                .flatMap { it.dependencies.withType(ProjectDependency::class.java) }
+                .map { it.path }
+                .toSet()
+        }
+        fun reaches(from: String, seen: MutableSet<String>): Boolean =
+            edges[from].orEmpty().any { next -> next == libraryPath || (seen.add(next) && reaches(next, seen)) }
+        return projects.filter { project ->
+            project.pluginManager.hasPlugin("com.android.application") && reaches(project.path, mutableSetOf())
+        }
+    }
+}
