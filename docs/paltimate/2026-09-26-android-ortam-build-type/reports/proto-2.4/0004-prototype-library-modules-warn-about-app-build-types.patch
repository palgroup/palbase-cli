+package io.palbase.gradle
+
+import io.palbase.gradle.LibraryFallbackCheck.AppBuildType
+import io.palbase.gradle.LibraryFallbackCheck.LibraryVariant
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+/**
+ * A library that lacks an app build type is packed into it through
+ * matchingFallbacks — the rule that decides when that hands the app build type
+ * a stack it would not have selected. The TestKit suite proves the library
+ * actually reads the app's build types; this pins the decision.
+ */
+class LibraryFallbackCheckTest {
+
+    private val gradle = mapOf("palbase.env.debug" to "main", "palbase.env.release" to "main")
+
+    @Test
+    fun `an app build type the library lacks is reported with the environment it actually gets`() {
+        val findings = check(
+            appBuildTypes = listOf(AppBuildType("featureX", listOf("debug"))),
+            resolver = places(gradle = gradle),
+        )
+
+        assertEquals(1, findings.size)
+        val finding = findings.single()
+        assertEquals("featureX", finding.appBuildType)
+        assertEquals(listOf("debug"), finding.packedVariants)
+        assertTrue(finding.message.contains("`:app` build type `featureX` is not declared in `:lib`"), finding.message)
+        assertTrue(finding.message.contains("`main` for `debug` (palbase.env.debug in gradle.properties)"), finding.message)
+        assertTrue(finding.message.contains("would select `featureX` (from the build type name)"), finding.message)
+        assertTrue(finding.message.contains("create(\"featureX\") { initWith(getByName(\"debug\")) }"), finding.message)
+        assertTrue(finding.message.contains("`palbase.env.featureX=main`"), finding.message)
+    }
+
+    // The same answer both ways is not a fall-back anybody suffers from — and it
+    // is how a team says "featureX runs on main, on purpose".
+    @Test
+    fun `naming the fallback's environment for the app build type silences it`() {
+        val findings = check(
+            appBuildTypes = listOf(AppBuildType("featureX", listOf("debug"))),
+            resolver = places(gradle = gradle + ("palbase.env.featureX" to "main")),
+        )
+        assertEquals(emptyList<LibraryFallbackCheck.Finding>(), findings)
+    }
+
+    @Test
+    fun `build types the library declares are not reported`() {
+        val findings = check(
+            appBuildTypes = listOf(AppBuildType("debug", emptyList()), AppBuildType("release", emptyList())),
+            resolver = places(gradle = gradle),
+        )
+        assertEquals(emptyList<LibraryFallbackCheck.Finding>(), findings)
+    }
+
+    // AGP itself fails the resolution when no fallback matches — loud already.
+    @Test
+    fun `an app build type with no usable fallback is left to AGP`() {
+        val findings = check(
+            appBuildTypes = listOf(AppBuildType("featureX", emptyList()), AppBuildType("qa", listOf("staging"))),
+            resolver = places(gradle = gradle),
+        )
+        assertEquals(emptyList<LibraryFallbackCheck.Finding>(), findings)
+    }
+
+    // The first fallback the library HAS is the one AGP picks.
+    @Test
+    fun `the first fallback the library declares is the one compared`() {
+        val findings = check(
+            appBuildTypes = listOf(AppBuildType("staging", listOf("qa", "release", "debug"))),
+            resolver = places(gradle = gradle + ("palbase.env.staging" to "main")),
+            libraryVariants = mapOf(
+                "debug" to listOf(LibraryVariant("debug", EnvironmentResolution.Selected("local", "the default for debug"))),
+                "release" to listOf(LibraryVariant("release", EnvironmentResolution.Selected("main", "x"))),
+            ),
+        )
+        assertEquals(emptyList<LibraryFallbackCheck.Finding>(), findings)
+    }
+
+    // benchmarkRelease measures release, and falls back to it: same stack, nothing to say.
+    @Test
+    fun `a benchmark build type that falls back to release is not reported`() {
+        val findings = check(
+            appBuildTypes = listOf(AppBuildType("benchmarkRelease", listOf("release"))),
+            resolver = places(gradle = gradle),
+        )
+        assertEquals(emptyList<LibraryFallbackCheck.Finding>(), findings)
+    }
+
+    // A fallback that cannot generate at all fails its own task; nothing to compare.
+    @Test
+    fun `a refused fallback is left to its own task`() {
+        val findings = check(
+            appBuildTypes = listOf(AppBuildType("featureX", listOf("release"))),
+            resolver = places(),
+            libraryVariants = mapOf(
+                "release" to listOf(LibraryVariant("release", EnvironmentResolution.Refused("no release"))),
+            ),
+        )
+        assertEquals(emptyList<LibraryFallbackCheck.Finding>(), findings)
+    }
+
+    // A flavored library: every variant of the fallback build type that differs is named.
+    @Test
+    fun `every flavored fallback variant that differs is named`() {
+        val findings = check(
+            appBuildTypes = listOf(AppBuildType("featureX", listOf("debug"))),
+            resolver = places(gradle = gradle),
+            libraryVariants = mapOf(
+                "debug" to listOf(
+                    LibraryVariant("freeDebug", EnvironmentResolution.Selected("main", "a")),
+                    LibraryVariant("paidDebug", EnvironmentResolution.Selected("featureX", "b")),
+                ),
+            ),
+        )
+        assertEquals(listOf("freeDebug"), findings.single().packedVariants)
+    }
+
+    private fun check(
+        appBuildTypes: List<AppBuildType>,
+        resolver: EnvironmentResolver,
+        libraryVariants: Map<String, List<LibraryVariant>> = mapOf(
+            "debug" to listOf(
+                LibraryVariant("debug", EnvironmentResolution.Selected("main", "palbase.env.debug in gradle.properties")),
+            ),
+            "release" to listOf(
+                LibraryVariant("release", EnvironmentResolution.Selected("main", "palbase.env.release in gradle.properties")),
